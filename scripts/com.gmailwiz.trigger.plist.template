<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.gmailwiz.trigger.plist — launchd unit for the M2 trigger service.

  This is a template. To deploy:
    1. Copy to ~/Library/LaunchAgents/com.gmailwiz.trigger.plist
    2. If your $HOME isn't /Users/gaylonvorwaller, search-and-replace it.
    3. `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gmailwiz.trigger.plist`

  Logs go to ~/logs/gmailwiz-trigger/{out,err}.log. The serve.sh wrapper
  is responsible for reading ~/gmailwiz/.env so secrets stay out of this
  plist (which is world-readable inside $HOME).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gmailwiz.trigger</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gaylonvorwaller/gmailwiz/scripts/serve.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gaylonvorwaller/gmailwiz</string>

    <!-- Run at boot/login and restart on crash. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Throttle restarts so a permanently-broken state doesn't spin -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logs. mkdir the parent dir before bootstrapping the unit. -->
    <key>StandardOutPath</key>
    <string>/Users/gaylonvorwaller/logs/gmailwiz-trigger/out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gaylonvorwaller/logs/gmailwiz-trigger/err.log</string>

    <!-- launchd strips PATH by default; restore a sane one for /usr/bin/sqlite3 etc. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
